# Copie para .env e ajuste. Nunca commite .env com segredos reais.

SECRET_KEY=dev-only-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# Local sem Docker: deixe vazio para SQLite. Compose injeta Postgres.
# DATABASE_URL=postgres://consultas:consultas@localhost:5432/consultas

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Asaas — mock-first (AD-004). Nunca coloque chave real no git.
# mock (default) | sandbox | prod — só mock está implementado.
ASAAS_MODE=mock
# Chave da API. Vazia no mock; necessária só se um cliente HTTP existir no futuro.
ASAAS_API_KEY=
# Token do webhook (header asaas-access-token). Vazio = fail-closed (401).
ASAAS_WEBHOOK_TOKEN=dev-webhook-token-nao-usar-em-prod
# Wallet da conta emissora. Split com este walletId é rejeitado.
ASAAS_WALLET_PLATFORM=wlt_platform_mock
